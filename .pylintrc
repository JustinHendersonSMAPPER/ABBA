[FORMAT]
max-line-length=120

[MASTER]
ignore-patterns=^tests/.*,^claude/.*,^abba2/.*
ignore=tests,claude,abba2
load-plugins=pylint.extensions.no_self_use

[MESSAGES CONTROL]
disable=
    too-few-public-methods,
    too-many-instance-attributes,
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-return-statements,
    too-many-public-methods,
    import-error,
    duplicate-code
